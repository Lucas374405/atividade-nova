<link rel="stylesheet" href="/style.css">

<h1>Jogos</h1>

<a href="/">Início</a>
<br>
<a href="/Devs">Desenvolvedoras</a>
<br>
<a href="/Generos">Gêneros</a>
<br><br>

<a href="/Jogo/cadastrar">Cadastrar novo jogo</a>

<ul>
    {{#each jogo}}
        <li>
            <a href="/Jogo/{{this.id}}">{{this.nome}}</a>
            - Ano: {{this.anoDeLancamento}}
            - Avaliação: {{this.avaliacao}}
            - Gênero: {{this.genero.nome}}
        </li>
    {{/each}}
</ul>